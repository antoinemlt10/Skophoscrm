# ─────────────────────────────────────────────────────────────
# Skophos CRM — environment variables
# Copy this file to ".env" and fill in your values.
# In Vercel, add these same keys under Project → Settings → Environment Variables.
# Every var MUST start with VITE_ to be readable by the React app.
# ─────────────────────────────────────────────────────────────

# --- Supabase (optional but recommended) ---
# If both are set, the app persists to Supabase Postgres and uses Supabase Auth.
# If left blank, the app automatically falls back to your browser's localStorage
# (data lives only on that one device — fine for a quick start).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Password gate (used ONLY in localStorage fallback mode) ---
# When Supabase is NOT configured, the app shows a simple password screen.
# Leave blank to disable the gate entirely (pure local dev).
# When Supabase IS configured, real Supabase email/password auth is used instead
# and this value is ignored.
VITE_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────
# SERVER-ONLY vars for the /api/cockpit-metrics endpoint.
# These are NOT prefixed with VITE_ on purpose — they must NEVER be bundled
# into the browser. Set them in Vercel as Environment Variables (no VITE_).
# ─────────────────────────────────────────────────────────────

# Supabase service role key — bypasses RLS to read aggregates server-side.
# SECRET. Found in Supabase → Project Settings → API → service_role. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the endpoint falls back to VITE_SUPABASE_URL if this is unset.
SUPABASE_URL=

# Protect the metrics endpoint when deployed. If set, callers must send
# "Authorization: Bearer <token>". Leave blank for unauthenticated local dev.
COCKPIT_API_TOKEN=

# Comma-separated list of origins allowed to call the endpoint (CORS).
# Defaults to http://localhost:5174 (the "Mon Cockpit" dev server).
COCKPIT_ALLOWED_ORIGINS=http://localhost:5174

# Onboarding goal shown as the "target" on the onboarded metric. Default 5.
COCKPIT_ONBOARD_TARGET=
